{
  "uid": "portfolio-api-overview",
  "title": "Portfolio API — Overview",
  "tags": ["portfolio", "cloud-run"],
  "timezone": "utc",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate by response class",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "stackdriver", "uid": "breeze-gcm" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "trading-portfolio-104696",
            "filters": [
              "resource.type", "=", "cloud_run_revision", "AND",
              "resource.label.service_name", "=", "trading-portfolio-prd-us", "AND",
              "metric.type", "=", "run.googleapis.com/request_count"
            ],
            "alignmentPeriod": "cloud-monitoring-auto",
            "perSeriesAligner": "ALIGN_RATE",
            "crossSeriesReducer": "REDUCE_SUM",
            "groupBys": ["metric.label.response_code_class"]
          }
        }
      ]
    },
    {
