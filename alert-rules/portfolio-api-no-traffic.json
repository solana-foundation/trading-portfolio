{
  "uid": "portfolio-api-no-traffic",
  "title": "portfolio-api: no successful traffic for 45m (service, auth, or canary down)",
  "ruleGroup": "portfolio-api",
  "folderUID": "portfolio",
  "noDataState": "Alerting",
  "execErrState": "Error",
  "for": "15m",
  "data": [
    {
      "refId": "A",
      "datasourceUid": "breeze-gcm",
      "queryType": "timeSeriesList",
      "relativeTimeRange": {
        "from": 2700,
        "to": 0
      },
      "model": {
        "refId": "A",
        "queryType": "timeSeriesList",
        "timeSeriesList": {
          "projectName": "trading-portfolio-104696",
          "filters": [
            "resource.type",
            "=",
            "cloud_run_revision",
            "AND",
            "resource.label.service_name",
            "=",
            "trading-portfolio-prd-us",
            "AND",
            "metric.label.response_code_class",
            "=",
            "2xx",
            "AND",
            "metric.type",
            "=",
            "run.googleapis.com/request_count"
          ],
          "alignmentPeriod": "cloud-monitoring-auto",
          "perSeriesAligner": "ALIGN_RATE",
          "crossSeriesReducer": "REDUCE_SUM",
          "groupBys": []
        }
      }
    },
    {
      "refId": "B",
      "datasourceUid": "__expr__",
      "queryType": "",
      "relativeTimeRange": {
        "from": 0,
        "to": 0
      },
      "model": {
        "type": "reduce",
        "refId": "B",
        "expression": "A",
        "reducer": "sum",
        "settings": {
          "mode": "replaceNN",
          "replaceWithValue": 0
        }
      }
    },
    {
      "refId": "C",
      "datasourceUid": "__expr__",
      "queryType": "",
      "relativeTimeRange": {
        "from": 0,
        "to": 0
      },
      "model": {
        "type": "threshold",
        "refId": "C",
        "expression": "B",
        "conditions": [
          {
            "evaluator": {
              "type": "lt",
              "params": [
                0.000001
              ]
            },
            "operator": {
              "type": "and"
            },
            "query": {
              "params": [
                "B"
              ]
            },
            "reducer": {
              "type": "last",
              "params": []
            },
            "type": "query"
          }
        ]
      }
    }
  ],
  "condition": "C",
  "annotations": {
    "summary": "Portfolio API served no successful (2xx) requests in the last 45 minutes. The canary probes every ~15m (GitHub cron jitter can stretch to ~30m), so the service, auth, or the canary is down."
  },
  "labels": {
    "service": "trading-portfolio",
    "severity": "critical",
    "slack": "true"
  },
  "notification_settings": {
    "receiver": "alerts-trading"
  }
}
