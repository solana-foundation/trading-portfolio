{
  "uid": "portfolio-sql-disk-high",
  "title": "portfolio-sql: disk > 80% for 15m",
  "ruleGroup": "portfolio-api",
  "folderUID": "portfolio",
  "noDataState": "OK",
  "execErrState": "Error",
  "for": "15m",
  "data": [
    {
      "refId": "A",
      "datasourceUid": "breeze-gcm",
      "queryType": "timeSeriesList",
      "relativeTimeRange": {
        "from": 900,
        "to": 0
      },
      "model": {
        "refId": "A",
        "queryType": "timeSeriesList",
        "timeSeriesList": {
          "projectName": "trading-portfolio-104696",
          "filters": [
            "resource.type",
            "=",
            "cloudsql_database",
            "AND",
            "resource.label.database_id",
            "=",
            "trading-portfolio-104696:trading-portfolio-prd",
            "AND",
            "metric.type",
            "=",
            "cloudsql.googleapis.com/database/disk/utilization"
          ],
          "alignmentPeriod": "cloud-monitoring-auto",
          "perSeriesAligner": "ALIGN_MEAN",
          "crossSeriesReducer": "REDUCE_MEAN",
          "groupBys": []
        }
      }
    },
    {
      "refId": "B",
      "datasourceUid": "__expr__",
      "queryType": "",
      "relativeTimeRange": {
        "from": 0,
        "to": 0
      },
      "model": {
        "type": "reduce",
        "refId": "B",
        "expression": "A",
        "reducer": "last",
        "settings": {
          "mode": "replaceNN",
          "replaceWithValue": 0
        }
      }
    },
    {
      "refId": "C",
      "datasourceUid": "__expr__",
      "queryType": "",
      "relativeTimeRange": {
        "from": 0,
        "to": 0
      },
      "model": {
        "type": "threshold",
        "refId": "C",
        "expression": "B",
        "conditions": [
          {
            "evaluator": {
              "type": "gt",
              "params": [
                0.8
              ]
            },
            "operator": {
              "type": "and"
            },
            "query": {
              "params": [
                "B"
              ]
            },
            "reducer": {
              "type": "last",
              "params": []
            },
            "type": "query"
          }
        ]
      }
    }
  ],
  "condition": "C",
  "annotations": {
    "summary": "Cloud SQL disk utilization above 80% for 15 minutes. Autoresize is on — sustained growth means runaway data or an autoresize quota problem."
  },
  "labels": {
    "service": "trading-portfolio",
    "severity": "warning",
    "slack": "true"
  },
  "notification_settings": {
    "receiver": "alerts-trading"
  }
}
